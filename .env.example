# Runtime obrigatório
DATABASE_URL=postgresql://user:password@host:5432/kliktech
KLIKTECH_SECRET_KEY=gere-uma-chave-aleatoria-com-32-ou-mais-bytes
KLIKTECH_ADMIN_EMAIL=admin@example.com
KLIKTECH_ADMIN_PASSWORD=gere-uma-senha-forte-com-10-ou-mais-caracteres
KLIKTECH_ADMIN_PATH=ademiroputo
KLIKTECH_ADMIN_TOTP_SECRET=BASE32_SECRET_DO_AUTENTICADOR
KLIKTECH_ADMIN_TOTP_ISSUER=KlikTech
# Só habilite temporariamente para provisionar o autenticador em ambiente controlado.
KLIKTECH_ADMIN_TOTP_SETUP_ENABLED=0
# Não existe desativação pelo cliente; a recuperação é feita pelo painel de suporte.
KLIKTECH_CNPJ=00.000.000/0000-00
KLIKTECH_PUBLIC_ORIGIN=https://seu-dominio.example

# Cookies e proxy
KLIKTECH_COOKIE_SECURE=1
KLIKTECH_TRUST_PROXY=0

# Pagamentos BravoPay
BRAVOPAY_API_KEY=bp_live_substitua_no_provedor
BRAVOPAY_WEBHOOK_SECRET=segredo-do-webhook

# Desenvolvimento local
# Use KLIKTECH_COOKIE_SECURE=0 em HTTP local.
